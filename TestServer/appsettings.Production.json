{
  "AppSettings": {
    "ProjectNo": "AiSen",
    "ProjectName": "AiSen Pic Service",
    "ServerPort": 9100,
    "MqttServer": "172.31.143.4",
    "MqttPort": 7076,
    "MqttClientId": "ffmpeg_client",
    "MqttUserName": "admin",
    "MqttPassword": "eLzuAJ@ghcZJkAD4m"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Async"
    ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "TestServer": "Information",
        "Serilog": "Information",
        "MQTTnet.Client": "Information",
        "Microsoft.Hosting.Lifetime": "Debug"
      }
    },
    "Properties": {
      "app": "Net7"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] ({ThreadId:000}) {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "logs/.log",
                "outputTemplate": "{Timestamp:HH:mm:ss.fff} [{Level:u3}] ({ThreadId:000}) {Message:lj}{NewLine}{Exception}",
                "rollingInterval": "Day",
                "rollOnFileSizeLimit": true,
                "fileSizeLimitBytes": 524288000
              }
            }
          ]
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithThreadId"
    ]
  }
}